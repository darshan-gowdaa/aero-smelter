// ==============================================================================
// ASG AIRLINES ENTERPRISE POWER BI DAX MEASURES LIBRARY
// Enterprise Flight Operations, Commercial Yield & MLOps Predictive Analytics
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. EXECUTIVE FLEET OPERATIONS & RELIABILITY MEASURES
// ------------------------------------------------------------------------------

Total Flights = 
COUNTROWS('fact_flights')

Total Block Hours = 
DIVIDE(SUM('fact_flights'[duration_minutes]), 60, 0)

Fleet Average Duration = 
AVERAGE('fact_flights'[duration_minutes])

Min Flight Duration = 
MIN('fact_flights'[duration_minutes])

Max Flight Duration = 
MAX('fact_flights'[duration_minutes])

Overnight Flight Count = 
CALCULATE(
    COUNTROWS('fact_flights'),
    'fact_flights'[is_overnight] = 1 || 'fact_flights'[is_overnight] = TRUE()
)

Overnight Flight % = 
DIVIDE([Overnight Flight Count], [Total Flights], 0)

Repaired Flight Count = 
CALCULATE(
    COUNTROWS('fact_flights'),
    'fact_flights'[flight_id] = "SJ192"
)

Flight Duration Outliers (>2σ) = 
CALCULATE(
    COUNTROWS('fact_flights'),
    'fact_flights'[is_duration_outlier] = 1 || 'fact_flights'[is_duration_outlier] = TRUE()
)

Duration Outlier Rate % = 
DIVIDE([Flight Duration Outliers (>2σ)], [Total Flights], 0)

Total Active Routes = 
DISTINCTCOUNT('dim_route'[route_key])

Total Operating Carriers = 
DISTINCTCOUNT('dim_airline'[airline_key])

// ------------------------------------------------------------------------------
// 2. BOOKING VOLATILITY & CANCELLATION RISK MEASURES
// ------------------------------------------------------------------------------

Total Bookings = 
COUNTROWS('fact_bookings')

Confirmed Bookings = 
CALCULATE(
    COUNTROWS('fact_bookings'),
    'fact_bookings'[is_confirmed] = 1
)

Confirmation Rate % = 
DIVIDE([Confirmed Bookings], [Total Bookings], 0)

Cancelled Bookings = 
CALCULATE(
    COUNTROWS('fact_bookings'),
    'fact_bookings'[is_cancelled] = 1
)

Cancellation Rate % = 
DIVIDE([Cancelled Bookings], [Total Bookings], 0)

Pending Bookings = 
CALCULATE(
    COUNTROWS('fact_bookings'),
    'fact_bookings'[is_pending] = 1
)

Pending Rate % = 
DIVIDE([Pending Bookings], [Total Bookings], 0)

Imputed Booking Status Count = 
CALCULATE(
    COUNTROWS('fact_bookings'),
    'fact_bookings'[is_status_imputed] = 1 || 'fact_bookings'[is_status_imputed] = TRUE()
)

High Risk Route Watchlist Flag = 
IF([Cancellation Rate %] > 0.35, 1, 0)

// ------------------------------------------------------------------------------
// 3. COMMERCIAL REVENUE, FARE YIELD & FINANCIAL LEAKAGE
// ------------------------------------------------------------------------------

Total Operational Revenue = 
SUM('fact_payments'[amount])

Average Fare Per Booking = 
AVERAGE('fact_payments'[amount])

Confirmed Gross Revenue = 
CALCULATE(
    SUM('fact_payments'[amount]),
    'fact_bookings'[is_confirmed] = 1
)

Cancelled Lost Revenue = 
CALCULATE(
    SUM('fact_payments'[amount]),
    'fact_bookings'[is_cancelled] = 1
)

Pending At-Risk Revenue = 
CALCULATE(
    SUM('fact_payments'[amount]),
    'fact_bookings'[is_pending] = 1
)

Yield Per Block Hour = 
DIVIDE([Total Operational Revenue], [Total Block Hours], 0)

UPI Revenue = 
CALCULATE(
    SUM('fact_payments'[amount]),
    'fact_payments'[payment_method] = "UPI"
)

Credit Card Revenue = 
CALCULATE(
    SUM('fact_payments'[amount]),
    'fact_payments'[payment_method] = "Credit Card"
)

Net Banking Revenue = 
CALCULATE(
    SUM('fact_payments'[amount]),
    'fact_payments'[payment_method] = "Net Banking"
)

UPI Revenue Share % = 
DIVIDE([UPI Revenue], [Total Operational Revenue], 0)

Credit Card Revenue Share % = 
DIVIDE([Credit Card Revenue], [Total Operational Revenue], 0)

Net Banking Revenue Share % = 
DIVIDE([Net Banking Revenue], [Total Operational Revenue], 0)

Imputed Payment Amount Count = 
CALCULATE(
    COUNTROWS('fact_payments'),
    'fact_payments'[is_amount_imputed] = 1 || 'fact_payments'[is_amount_imputed] = TRUE()
)

// ------------------------------------------------------------------------------
// 4. MLOPS PREDICTIVE & ANOMALY DETECTION MEASURES
// ------------------------------------------------------------------------------

ML Flagged Anomaly Flights = 
CALCULATE(
    COUNTROWS('ml_anomaly_scores'),
    'ml_anomaly_scores'[ml_is_anomaly] = 1
)

ML Anomaly Contamination % = 
DIVIDE([ML Flagged Anomaly Flights], [Total Flights], 0)

Average ML Anomaly Score = 
AVERAGE('ml_anomaly_scores'[ml_anomaly_score])

High Risk Cancellation Predictions = 
CALCULATE(
    COUNTROWS('ml_cancellation_predictions'),
    'ml_cancellation_predictions'[cancellation_risk_score] > 0.40
)

Average Cancellation Risk Score = 
AVERAGE('ml_cancellation_predictions'[cancellation_risk_score])

Random Forest Accuracy % = 0.6921

Gradient Boosting Fare MAE = 3436.22

// ------------------------------------------------------------------------------
// 5. DYNAMIC SWITCH MEASURES & INTERACTIVE SLICERS
// ------------------------------------------------------------------------------

// Disconnected Slicer Measure to toggle primary chart KPI
Dynamic Selected Metric = 
SWITCH(
    SELECTEDVALUE('MetricSlicer'[MetricID], 1),
    1, [Total Flights],
    2, [Fleet Average Duration],
    3, [Cancellation Rate %],
    4, [Total Operational Revenue],
    5, [ML Flagged Anomaly Flights],
    [Total Flights]
)

// Dynamic Card & Visual Title based on active filter
Dynamic Report Title = 
VAR Carrier = SELECTEDVALUE('dim_airline'[airline_name], "All Carriers")
VAR Sector = SELECTEDVALUE('dim_route'[route_name], "All Network Routes")
RETURN
"Operational Performance Report — " & Carrier & " | " & Sector

// Dynamic Subtitle showing data freshness & audit status
Dynamic Audit Banner = 
"Audited Gold Layer Data: 1,005 Flights · 1,000 Bookings · 100% PII Masked (SHA-256) · 7/7 Pipeline Tests Verified"

// ------------------------------------------------------------------------------
// 6. CONDITIONAL FORMATTING DAX (HEX COLOR CODES)
// ------------------------------------------------------------------------------

Cancellation Rate Color Hex = 
SWITCH(
    TRUE(),
    [Cancellation Rate %] >= 0.35, "#F43F5E", // High Risk (Red)
    [Cancellation Rate %] >= 0.28, "#F59E0B", // Warning / Elevated (Amber)
    "#10B981"                                 // Healthy / Normal (Emerald Green)
)

Anomaly Severity Color Hex = 
SWITCH(
    TRUE(),
    [Average ML Anomaly Score] >= 0.60, "#F43F5E", // Severe Anomaly (Red)
    [Average ML Anomaly Score] >= 0.45, "#F59E0B", // Moderate Deviation (Amber)
    "#0284C7"                                      // Normal Operational Corridor (Sky Blue)
)

Overnight Status Color Hex = 
IF([Overnight Flight Count] > 0, "#F59E0B", "#64748B")

Booking Status Color Hex = 
SWITCH(
    SELECTEDVALUE('fact_bookings'[status]),
    "CONFIRMED", "#10B981",
    "CANCELLED", "#F43F5E",
    "PENDING", "#F59E0B",
    "#64748B"
)
